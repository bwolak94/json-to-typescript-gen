{
  "name": "@quick-mock-server/core",
  "version": "0.0.1",
  "description": "Core runtime for quick-mock-server",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@faker-js/faker": "^10.6.0",
    "chokidar": "^5.0.0",
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "json-schema-faker": "^0.6.3",
    "openapi-types": "^12.1.3",
    "undici": "^8.11.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zod-to-json-schema": "^3.25.2"
  }
}
