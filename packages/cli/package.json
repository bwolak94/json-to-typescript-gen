{
  "name": "quick-mock-server",
  "version": "0.0.1",
  "description": "Lightweight, config-driven HTTP mock server",
  "type": "module",
  "bin": {
    "qms": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quick-mock-server/core": "workspace:*",
    "cac": "^7.0.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pino": "^7.0.5",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
